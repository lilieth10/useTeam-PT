{
  "name": "Kanban Backlog Export",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kanban-export",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "functionCode": "// Extraer datos del webhook - usar directamente los datos del backend\nconst webhookData = $input.item.json.body || $input.item.json;\nconst boardId = webhookData.boardId;\nconst tasks = webhookData.tasks || [];\nconst email = webhookData.email;\n\n// NO procesar los datos - usar tal como vienen del backend\n// El backend ya los formateó correctamente\nconst result = {\n  boardId,\n  email,\n  cards: tasks, // Usar directamente sin modificar\n  totalCards: tasks.length,\n  exportDate: new Date().toISOString()\n};\n\nreturn { json: result };"
      },
      "id": "process-data",
      "name": "Process Data",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "toFile",
        "fileFormat": "csv",
        "options": {
          "fileName": "Backlog_Kanban_{{new Date().toISOString().split('T')[0]}}.csv",
          "headerRow": true
        }
      },
      "id": "generate-csv",
      "name": "Generate CSV",
      "type": "n8n-nodes-base.spreadsheetFile",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.EMAIL_FROM}}",
        "toEmail": "={{$json.email || $env.EMAIL_TO}}",
        "subject": "Exportación de Backlog - Tablero Kanban",
        "emailType": "html",
        "message": "<h2>Exportación de Backlog Completada</h2><p>Se ha generado la exportación del backlog de tu tablero Kanban.</p><p><strong>Total de tarjetas:</strong> {{$json.totalCards}}</p><p><strong>Fecha de exportación:</strong> {{$json.exportDate}}</p><p>El archivo CSV está adjunto a este correo.</p><br><p>Saludos,<br>Equipo Kanban</p>",
        "attachments": "data",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [850, 300],
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP Account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Backlog exportado exitosamente\",\n  \"totalCards\": {{$json.totalCards}},\n  \"exportDate\": \"{{$json.exportDate}}\"\n}",
        "options": {}
      },
      "id": "http-response",
      "name": "HTTP Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Process Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Data": {
      "main": [
        [
          {
            "node": "Generate CSV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate CSV": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "HTTP Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "id": "kanban-backlog-export",
  "meta": {
    "instanceId": "kanban-board"
  },
  "tags": []
}
